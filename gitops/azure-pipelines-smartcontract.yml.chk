# IWonPaymentSmartContract — Azure DevOps 파이프라인
#
IWonPaymentSmartContract 프로젝트 배포를 추가하고, 배포하면서 변경되는 시크릿(지갑 키, 컨트랙트 주소 등)을 
Azure Key Vault에 자동으로 반영하는 ADO 파이프라인 정의입니다. 현재 작성된 스크립트를 기존 배포 프로세스에 통합하여, 
배포 후 Key Vault 업데이트를 자동화하는 것을 목표로 합니다.
# 역할: integration 서버에서 hardhat .js 스크립트를 실행하고,
#       실행 결과(지갑 키, 컨트랙트 주소)를 Azure Key Vault에 반영합니다.
#
# 사전 준비 (ADO 프로젝트 설정):
#   1. Variable Group 'iwon-keyvault-config' 생성 후 아래 변수 등록
#      - AZ_KEYVAULT_NAME        : Key Vault 이름 (예: iwon-smart-kv)
#      - AZURE_SERVICE_CONNECTION: Azure 서비스 연결 이름
#   2. 서비스 연결에 Key Vault '비밀 목록 조회/설정' 권한 부여
#
# Key Vault 초기 시크릿 (최초 1회 수동 등록 필요):
#   IWON-COMPANY-PRIVATE-KEY   IWON-ADMIN-PRIVATE-KEY
#   IWON-TOKEN-ADDRESS         IWON-ADMIN-ADDRESS
#   IWON-OPERATOR-ADDRESS      IWON-SEPOLIA-RPC-URL

trigger:
  branches:
    include:
      - main
  paths:
    include:
      - hardhat/contracts/**
      - hardhat/scripts/**
      - hardhat/hardhat.config.ts
      - azure-pipelines.yml

parameters:
  - name: operation
    displayName: '실행할 작업'
    type: string
    default: verify
    values:
      - verify            # on-chain 상태 검증만 (Key Vault 변경 없음)
      - rotate-and-sync   # 지갑 로테이션 후 Key Vault 동기화
      - deploy-and-sync   # 새 컨트랙트 배포 후 Key Vault 동기화
      - sync-only         # 현재 .env 값을 Key Vault에 쓰기만

variables:
  - group: iwon-keyvault-config
  - name: HARDHAT_DIR
    value: $(Build.SourcesDirectory)/hardhat

pool:
  vmImage: ubuntu-latest

stages:
  - stage: SmartContractOps
    displayName: 'SmartContract: ${{ parameters.operation }}'
    jobs:
      - job: Run
        displayName: 'Hardhat 스크립트 실행'
        timeoutInMinutes: 30
        steps:

          # ── 1. Node.js 설치 ────────────────────────────────────────────────
          - task: NodeTool@0
            displayName: 'Node.js 22 설치'
            inputs:
              versionSpec: '22.x'

          # ── 2. npm 의존성 설치 ─────────────────────────────────────────────
          - script: npm ci
            displayName: 'npm ci'
            workingDirectory: $(HARDHAT_DIR)

          # ── 3. Key Vault에서 현재 시크릿 로드 ──────────────────────────────
          - task: AzureKeyVault@2
            displayName: 'Key Vault에서 시크릿 가져오기'
            inputs:
              azureSubscription: $(AZURE_SERVICE_CONNECTION)
              KeyVaultName: $(AZ_KEYVAULT_NAME)
              SecretsFilter: >-
                IWON-COMPANY-PRIVATE-KEY,IWON-ADMIN-PRIVATE-KEY,
                IWON-TOKEN-ADDRESS,IWON-ADMIN-ADDRESS,
                IWON-OPERATOR-ADDRESS,IWON-SEPOLIA-RPC-URL
              RunAsPreJob: false

          # ── 4. Key Vault 시크릿으로 .env 파일 복원 ─────────────────────────
          # 시크릿 값은 env: 블록으로 전달 → ADO가 로그에서 자동 마스킹
          - script: |
              node - <<'JSCODE'
              const fs = require('fs');
              const lines = [
                'OPERATOR_PRIVATE_KEY=' + process.env.IWON_COMPANY_PRIVATE_KEY,
                'ADMIN_PRIVATE_KEY='    + process.env.IWON_ADMIN_PRIVATE_KEY,
                'TOKEN_ADDRESS='        + process.env.IWON_TOKEN_ADDRESS,
                'PROXY_ADDRESS='        + process.env.IWON_TOKEN_ADDRESS,
                'ADMIN_ADDRESS='        + process.env.IWON_ADMIN_ADDRESS,
                'OPERATOR_ADDRESS='     + process.env.IWON_OPERATOR_ADDRESS,
                'SEPOLIA_RPC_URL='      + process.env.IWON_SEPOLIA_RPC_URL,
              ];
              fs.writeFileSync(process.env.HARDHAT_DIR + '/.env', lines.join('\n') + '\n');
              console.log('.env 복원 완료 (값은 출력하지 않음)');
              JSCODE
            displayName: '.env 복원 (Key Vault → 파일)'
            env:
              IWON_COMPANY_PRIVATE_KEY:  $(IWON-COMPANY-PRIVATE-KEY)
              IWON_ADMIN_PRIVATE_KEY:    $(IWON-ADMIN-PRIVATE-KEY)
              IWON_TOKEN_ADDRESS:        $(IWON-TOKEN-ADDRESS)
              IWON_ADMIN_ADDRESS:        $(IWON-ADMIN-ADDRESS)
              IWON_OPERATOR_ADDRESS:     $(IWON-OPERATOR-ADDRESS)
              IWON_SEPOLIA_RPC_URL:      $(IWON-SEPOLIA-RPC-URL)
              HARDHAT_DIR:               $(HARDHAT_DIR)

          # ── 5a. [verify] on-chain 상태 검증 ───────────────────────────────
          - ${{ if eq(parameters.operation, 'verify') }}:
            - script: |
                npx hardhat run scripts/verify_rotation.js --network sepolia
              displayName: 'verify_rotation.js 실행'
              workingDirectory: $(HARDHAT_DIR)

          # ── 5b. [rotate-and-sync] 지갑 로테이션 ───────────────────────────
          - ${{ if eq(parameters.operation, 'rotate-and-sync') }}:
            - script: |
                npx hardhat run scripts/rotate_keys.js --network sepolia
              displayName: 'rotate_keys.js 실행'
              workingDirectory: $(HARDHAT_DIR)

          # ── 5c. [deploy-and-sync] 컨트랙트 업그레이드 ────────────────────
          - ${{ if eq(parameters.operation, 'deploy-and-sync') }}:
            - script: |
                npx hardhat run scripts/upgrade_proxy.js --network sepolia
              displayName: 'upgrade_proxy.js 실행'
              workingDirectory: $(HARDHAT_DIR)

          # ── 6. 변경된 .env → Key Vault 동기화 ─────────────────────────────
          # verify는 .env를 변경하지 않으므로 건너뜀
          - ${{ if ne(parameters.operation, 'verify') }}:
            - task: AzureCLI@2
              displayName: '.env → Key Vault 동기화 (sync_keyvault.js)'
              inputs:
                azureSubscription: $(AZURE_SERVICE_CONNECTION)
                scriptType: bash
                scriptLocation: inlineScript
                inlineScript: |
                  set -euo pipefail
                  node hardhat/scripts/sync_keyvault.js
              env:
                AZ_KEYVAULT_NAME: $(AZ_KEYVAULT_NAME)
              workingDirectory: $(Build.SourcesDirectory)

          # ── 7. .env 파일 정리 (항상 실행) ─────────────────────────────────
          - script: |
              rm -f "$(HARDHAT_DIR)/.env"
              echo ".env 삭제 완료"
            displayName: '.env 파일 정리'
            condition: always()
